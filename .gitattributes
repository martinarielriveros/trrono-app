# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.env* text eol=lf
Dockerfile* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
