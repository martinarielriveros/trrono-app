# ==============================================================================
# TRONNO - Marketplace de Baños (Argentina)
# Archivo de variables de entorno de ejemplo (.env.example)
# ==============================================================================

# Entorno: development | staging | production
ENVIRONMENT=development

# Configuración de base de datos PostgreSQL + PostGIS
POSTGRES_USER=tronno_user
POSTGRES_PASSWORD=tronno_password
POSTGRES_DB=tronno_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Nota: en Docker Compose usar 'db', en local fuera de Docker usar 'localhost'
DATABASE_URL=postgresql+psycopg://tronno_user:tronno_password@db:5432/tronno_db

# Seguridad y Autenticación JWT
SECRET_KEY=tronno_dev_secret_key_change_me_in_production_min_32_chars_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zona horaria (Todas las fechas se persisten en UTC y se presentan en hora de Buenos Aires)
TIMEZONE=America/Argentina/Buenos_Aires

# CORS (Orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Pagos - Mercado Pago Argentina
# PAYMENTS_MODE: 'mock' (simulación local sin MP) o 'live' (Checkout Pro real)
PAYMENTS_MODE=mock
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADO_PAGO_WEBHOOK_SECRET=

# Fotos - Cloudinary (Plan Free)
CLOUDINARY_CLOUD_NAME=tronno_dev
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=dev_cloudinary_secret_123

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Usuario Administrador inicial (creado por app.seed)
ADMIN_EMAIL=admin@tronno.com.ar
ADMIN_PASSWORD=Admin12345!

# Correo electrónico / SMTP
# En desarrollo local: EMAILS_TO_CONSOLE=true imprime los correos en la consola del backend
EMAILS_TO_CONSOLE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=hola@tronno.com.ar

# URLs de la aplicación
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
